/* Builtin help is explicit; do not change echo/printf/test argument semantics. */
static int builtin_help(const char *topic){
 static const struct {const char *name,*text;} entries[]={
 {"appinstall","appinstall check FILE | replace FILE NAME | repair NAME | recover NAME\nManage independently installed /bin commands; never silently overwrite.\nNAME: 1..20 letters/digits/_/-. check fully verifies without execution.\nreplace verifies FILE and preserves a recovery copy before installation.\nrepair explicitly installs the bundled version; recover restores .old.\nPrevious files retain both forks; existing Finder metadata is preserved.\nNew commands contain a data fork; old resource forks stay in the backup.\nExisting .clx-NAME.old/.new files block replacement: inspect them first.\nCLX_VERIFY=strict verifies each launch; installed enables receipt\nchecks.\nStatus: 0 success, nonzero verification/file error, 130 interrupted.\n"},
 {"cd","cd [directory]\nChange shell directory; default is the Clarice root. Paths may use /mnt.\n"},
 {"pwd","pwd\nPrint the full current shell path.\n"},
 {"echo","echo [word ...]\nPrint arguments separated by spaces and a newline; no option processing.\n"},
 {"printf","printf [--] format [argument ...]\nFormat arguments to stdout; repeat format while arguments remain.\nConversions: %s %b %c %d %i %u %o %x %X and %%.\nLiteral width/precision and integer flags - + space 0 # are supported.\nMissing operands supply empty strings or zero. Numbers accept base\nprefixes\nand a quoted character. %b decodes escapes; its \\c stops all output.\nEscapes: \\a \\b \\f \\n \\r \\t \\v \\\\ and octal; binary NUL is preserved.\nNo floating conversions or dynamic * width/precision. Integers are\n32-bit.\nExample: printf '%s\\n' \"$@\"\nStatus: 0 success, 1 bad number/output error, 2 bad format, 130\ncancelled.\n"},
 {"export","export [-p] | export name[=value] ...\nMark variables for child commands; assignment also sets their value.\nNo operands or -p prints shell-quoted export statements, including unset\nexported names. Private shell variables are not passed to applications.\nNames, values and entry counts grow with available application memory.\nExample: export PATH=/bin:/usr/bin\nStatus: 0 success, 2 invalid name/allocation failure. See help unset.\n"},
 {"unset","unset [-v|-f] name ...\nRemove variables (-v, default), or shell functions (-f).\nRemoving an absent name succeeds. No readonly variables or Unix\nprocesses.\nStatus: 0 success, 2 invalid name. See help export and help set.\n"},
 {"set","set | set [--|-] argument ...\nWithout operands list current set variables. With operands replace $1,\n$2, etc.; $0 is retained. Use -- before operands beginning with - or +.\nset -- clears arguments; a lone set - leaves arguments unchanged.\nNo shell-option flags such as -e, -u or -f. Storage grows with memory.\nStatus: 0 success, 2 unsupported option or allocation failure.\n"},
 {"shift","shift [count]\nDrop positional arguments; default one.\n"},
 {"read","read [-r] [--] name ...\nRead one stdin record, split using IFS and assign variables in order.\nThe last variable receives the remaining fields. -r keeps backslashes;\notherwise backslash quotes the next byte and joins escaped newlines.\nRecords grow with available memory. LF and native CR terminate records.\nNUL bytes are rejected; this is text input, not binary copying.\nAssignment is staged: allocation failure leaves previous values intact.\nEOF still assigns collected input, then returns nonzero. Check status.\nExample: while IFS= read -r line; do printf '%s\\n' \"$line\"; done < file\nStatus: 0 record read, 1 EOF, 2 error, 130 cancelled.\n"},
 {"sh","sh file [argument ...] | sh -c command [name [argument ...]]\nRun a script in a private shell environment; name becomes $0 with -c.\nExported values are inherited; unexported variables/functions are not.\nQuotes, expansion, functions, loops, redirection and finite pipelines\nare\nsupported. Source, tokens and functions grow with available memory.\nPipes use sequential /tmp spools, not simultaneous Unix processes.\nRecursion is bounded for the native stack. No jobs, traps or Bash\nsyntax.\nStatus: last command, explicit exit status, 2 error, 130 cancelled.\nSee help . to run a script in the current environment.\n"},
 {".",". file [argument ...]\nRead a script in the current shell; variable/function changes persist.\nWith no arguments, positional changes also persist. Explicit arguments\nare scoped to the script in Clarice. File is a path, not a PATH search.\nStatus: script result, 2 read/parse error, 130 cancelled. See help sh.\n"},
 {"test","test expression | [ expression ]\nReturn 0 for true, 1 for false, 2 for invalid expressions.\nFiles: -e exists, -f nondirectory, -d directory, -s nonempty data fork,\n-L/-h Clarice symbolic link. Follow links for other file tests.\nStrings: -n nonempty, -z empty, left = right, left != right.\nIntegers: -eq -ne -lt -le -gt -ge (signed native 32-bit decimal).\n! negates; quoted parentheses group a supported expression.\nUse shell && and ||, not legacy -a/-o. Quote expansions with spaces.\nNo Unix ownership or access-permission tests on HFS.\nExample: test -f \"$path\" && printf '%s\\n' \"$path\"\n"},
 {"[","[ expression ]\nThe test builtin with a required separate closing ] operand.\nUse help test for all operators, statuses and HFS differences.\n"},
 {"true","true [argument ...]\nReturn success.\n"},{"false","false [argument ...]\nReturn status 1.\n"},{":",": [argument ...]\nNo operation; return success.\n"},
 {"break","break\nLeave the current loop; numeric levels unsupported.\n"},{"continue","continue\nStart the next iteration; numeric levels unsupported.\n"},
 {"return","return [status]\nReturn from a function or script.\n"},{"exit","exit [status]\nExit the script, or quit Clarice at the interactive prompt.\n"},
 {"history","history [on|off|clear]\nList or control the bounded disk-backed history in\n/etc/clarice/clarice.history.\nUp/Down traverse entries; history is separate from scrollback.\n"},
 {"prefs","prefs [setting [value]]\nWith no arguments show current preferences. Settings:\nwindow: open Preferences; fonts: list installed fonts.\nfont name: choose installed font (quote spaces); size N: 6..24 points.\ncolours dark|light: apply theme immediately; fill: toggle full-screen.\ncontrol control|option|command: choose Control substitute.\nscrollback 32|64|128: retained lines; reducing it discards older lines.\npaging off|screen|100: output paging; columns N: 20..130 if screen fits.\nChanges persist in /etc/clarice/clarice.conf. Rendering is automatic.\nPhysical Control always works; Option is the default substitute.\nCommand mode preserves menu shortcuts; add Option for conflicts.\nCommand-period cancels locally, including editors and serial.\nStatus: 0 success, 2 invalid setting. See help history and help status.\n"},
 {"status","status [-h] | status runtime\nShow terminal/application metrics; -h retains human-readable formatting.\nruntime shows the last CLX command's timing, memory and loader phases.\nHeap and largest block belong to Clarice's application partition.\nNot Unix process accounting, total machine free RAM or CPU utilisation.\nStatus: 0 success, 2 invalid arguments. See help prefs.\n"},
 {"clear","clear\nClear the terminal display.\n"},
 {"selftest","selftest\nRun built-in ABI/parser/scan checks.\n"},{"checks","checks\nRun the application test set.\n"},{"scrollbench","scrollbench [quick|native|cached]\nRun rendering diagnostics; no argument runs the default benchmark.\nquick is a shorter check; native/cached compare renderer paths.\nAdditional developer modes require a diagnostic build and are not\nproduction interface promises. This is not a Unix utility.\n"},
 {"help","help [builtin] | help --help\nShow shell builtin documentation; external commands use command --help.\nHelp describes Clarice's implemented subset, not POSIX certification.\nStatus: 0 success, 1 unknown builtin, 2 too many arguments.\n"}
 };
 for(unsigned i=0;i<sizeof entries/sizeof entries[0];i++)if(!strcmp(topic,entries[i].name)){say(entries[i].text);return 0;}
 errsay("help: unknown builtin; try command --help for an external utility\n");return 1;
}
static int help_command(int argc,char **av){if(argc>2)return 2;if(argc==2)return builtin_help(!strcmp(av[1],"--help")?"help":av[1]);say("Clarice: native System 6 command shell\nBuiltins: cd pwd echo printf export unset set shift read sh . test\n          true false : break continue return exit history prefs status clear appinstall\nUse help NAME for builtin details; command --help for external tools.\n/bin: ls df cat grep sed awk wc head tail cut tr sort uniq tee\n      cp mv touch mkdir rmdir rm ln readlink hfsattr\n      find du file od basename dirname more\nUp/Down: history; Tab: completion; Ctrl+C/Cmd-period: interrupt; prefs control sets a substitute.\nPOSIX sh is a compatibility target; current scripting/pipes are bounded.\nchmod is not implemented: hfsattr handles meaningful HFS metadata.\n");return 0;}
