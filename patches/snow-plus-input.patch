+#[cfg(test)]
+mod clarice_input_tests {
+    use super::*;
+    #[test]
+    fn arrow_packets_preserve_make_break_and_order() {
+        let mut k = PlusKeyboard::default();
+        for (key, byte) in [(0x3E,0x1B),(0x3D,0x11),(0x3B,0x0D),(0x3C,0x05)] {
+            k.event(KeyEvent::KeyDown(key,Keymap::Universal));
+            k.event(KeyEvent::KeyUp(key,Keymap::Universal));
+            assert_eq!(k.cmd(0x10).unwrap(),0x79);
+            assert_eq!(k.cmd(0x14).unwrap(),byte);
+            assert_eq!(k.cmd(0x10).unwrap(),0x79);
+            assert_eq!(k.cmd(0x14).unwrap(),byte|0x80);
+            assert_eq!(k.cmd(0x10).unwrap(),0x7B);
+        }
+    }
+    #[test]
+    fn focus_release_finishes_partial_arrow_packet() {
+        let mut k = PlusKeyboard::default();
+        k.event(KeyEvent::KeyDown(0x3E,Keymap::Universal));
+        assert_eq!(k.cmd(0x10).unwrap(),0x79);
+        k.release_all();
+        for byte in [0x1B,0x79,0x9B,0x7B] { assert_eq!(k.cmd(0x14).unwrap(),byte); }
+        assert!(k.keystate.iter().all(|state| !state));
+    }
+    #[test]
+    fn ordinary_keys_and_mac_modifiers_are_unchanged() {
+        let mut k = PlusKeyboard::default();
+        for (key,byte) in [(0x00,0x01),(0x38,0x71),(0x3A,0x75),(0x37,0x6F)] {
+            k.event(KeyEvent::KeyDown(key,Keymap::Universal));
+            k.event(KeyEvent::KeyUp(key,Keymap::Universal));
+            assert_eq!(k.cmd(0x10).unwrap(),byte);
+            assert_eq!(k.cmd(0x10).unwrap(),byte|0x80);
+        }
+    }
+    #[test]
+    fn option_c_preserves_both_key_releases() {
+        let mut k = PlusKeyboard::default();
+        k.event(KeyEvent::KeyDown(0x3A,Keymap::Universal));
+        k.event(KeyEvent::KeyDown(0x08,Keymap::Universal));
+        k.event(KeyEvent::KeyUp(0x08,Keymap::Universal));
+        k.event(KeyEvent::KeyUp(0x3A,Keymap::Universal));
+        for byte in [0x75,0x11,0x91,0xF5,0x7B] { assert_eq!(k.cmd(0x10).unwrap(),byte); }
+    }
+    #[test]
+    fn focus_release_does_not_leave_keys_down() {
+        let mut k = PlusKeyboard::default();
+        k.event(KeyEvent::KeyDown(0x3A,Keymap::Universal));
+        assert_eq!(k.cmd(0x10).unwrap(),0x75);
+        k.event(KeyEvent::KeyDown(0x08,Keymap::Universal));
+        k.release_all();
+        assert_eq!(k.cmd(0x10).unwrap(),0xF5);
+        assert_eq!(k.cmd(0x10).unwrap(),0x7B);
+    }
+}
