+    // Development-only loopback forwarding, opt-in by environment variable.
+    // Reuse existing smoltcp and NAT teardown/backpressure; no LAN listener.
+    fn accept_test_connection(&mut self) -> Result<()> {
+        use smoltcp::socket::tcp;
+        let Some((listener, guest)) = &self.test_forward else { return Ok(()); };
+        let guest = *guest;
+        let os_socket = match listener.accept() {
+            Ok((s, _)) => s,
+            Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => return Ok(()),
+            Err(e) => return Err(e.into()),
+        };
+        os_socket.set_nonblocking(true)?;
+        self.test_port = if self.test_port == 60000 { 40000 } else { self.test_port + 1 };
+        let local = IpEndpoint::new(self.gateway_ip, self.test_port);
+        let mut socket = tcp::Socket::new(tcp::SocketBuffer::new(vec![0; SMOLTCP_BUFFER_SIZE]), tcp::SocketBuffer::new(vec![0; SMOLTCP_BUFFER_SIZE]));
+        socket.connect(self.iface.context(), guest, local)?;
+        let handle = self.sockets.add(socket);
+        self.nat_table.insert(handle, NatEntry::Tcp(TcpEntry { os_socket,
+            remote_endpoint: local, local_endpoint: guest,
+            expires_at: Instant::now() + NAT_TIMEOUT_TCP_OPEN, local_fin_forwarded: false }));
+        Ok(())
     }
 
